PLC_API_BASE_URL=https://your-server.example.com
PLC_API_USERNAME=your_username
PLC_API_PASSWORD=your_password
PLC_API_VERIFY_SSL=true
LOCAL_AUTH_USERNAME=frontend_username
LOCAL_AUTH_PASSWORD=frontend_password
LOCAL_AUTH_SECRET=change_me_to_a_long_random_secret
LOCAL_AUTH_TOKEN_EXPIRES_SECONDS=3600

# Database ordini di produzione (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=db_user
DB_PASSWORD=change_me
DB_NAME=db_name

# Venting monitor (Optotech Scandicci - Step7)
VENTING_POLL_INTERVAL_SECONDS=5
VENTING_WEBHOOK_URL=https://your-webhook-endpoint.example.com/venting
VENTING_LOG_FILE=/tmp/venting_events.log
# Modalità fine lavoro: "venting_stop" (default) = spara quando Venting running → macchina ferma
#                       "venting_start" = spara quando entra in Venting (macchina ancora running)
OPTOTECH_END_OF_WORK_TRIGGER=venting_stop

# Buhler venting monitor (Buhler Scandicci - OPC-UA)
# BUHLER_VENTING_WEBHOOK_URL se vuoto usa VENTING_WEBHOOK_URL come fallback
BUHLER_VENTING_POLL_INTERVAL_SECONDS=30
BUHLER_VENTING_WEBHOOK_URL=https://your-webhook-endpoint.example.com/buhler-venting

SMTP_HOST=smtp_server_address
SMTP_PORT=smtp_port
SMTP_USER=email_from_address
SMTP_PASSWORD=pwd
EMAIL_FROM_NAME=emial_from_name
EMAIL_TO=email_to_address